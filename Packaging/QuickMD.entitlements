<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Open and save notes through Finder and the Open/Save panels. -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <!-- Folders granted for images and linked notes, kept across launches. -->
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
    <!-- File › Print. -->
    <key>com.apple.security.print</key><true/>
    <!-- Remote images in the preview (the app itself makes no requests). -->
    <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
